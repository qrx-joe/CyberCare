# Local demo only. Never put credentials in browser files or Git.
PORT=4310
# Installed Chrome/Edge is used by the real server-side axe audit.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional real vision mode: all three values are required; no default model guess.
# STEPFUN_API_KEY=
# STEPFUN_BASE_URL=https://api.stepfun.com/v1
# For Step Plan quota, use this base instead of the pay-per-request base above:
# STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
# Verify the selected endpoint's model catalog includes an image-capable model.
# STEPFUN_MODEL=
# Hard process-wide cap, including failed requests. No automatic retries.
MODEL_REQUEST_LIMIT=10
