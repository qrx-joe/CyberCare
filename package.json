{
  "name": "cybercare-poster-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "evaluate": "npm run build && node --env-file-if-exists=.env scripts/evaluate.mjs"
  },
  "dependencies": {
    "axe-core": "4.14.0",
    "image-size": "2.0.4",
    "playwright-core": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
